package(default_visibility = ["//visibility:public"])

# The Swift runtime archives are built against libstdc++, so linking a Linux Swift
# binary needs hermetic-llvm's libstdc++ instead of its default libc++.
platform(
    name = "linux_libstdcxx",
    constraint_values = ["@llvm//constraints/cxxstdlib:libstdcxx.12.5.0"],
    parents = ["@platforms//host"],
)

# The homelab Buildbarn workers: Ubuntu 26.04 on x86_64. The exec_properties
# must match the worker's platform properties exactly.
platform(
    name = "linux_x86_64_remote",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        # See linux_libstdcxx above.
        "@llvm//constraints/cxxstdlib:libstdcxx.12.5.0",
    ],
    exec_properties = {
        "ISA": "x86_64",
        "OSFamily": "linux",
        "pool": "k8s-ubuntu26-04",
    },
)

# The homelab Buildbarn Mac worker: macOS on Apple silicon. Actions that use
# Xcode run with the worker's Xcode, so keep its version in step with the
# client's. The exec_properties must match the worker's platform properties
# exactly.
platform(
    name = "macos_remote",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:aarch64",
    ],
    exec_properties = {
        "ISA": "aarch64",
        "OSFamily": "darwin",
        "pool": "mac",
    },
)
