build --compilation_mode=opt
build --java_runtime_version=remotejdk_25

# Reuse action outputs across clean builds and CI jobs.
build --disk_cache=~/.cache/bazel/disk

# Use apple_support's new rules-based cc toolchain, which will eventually
# replace its legacy templated toolchain (off by default as of 2.7.0)
# https://github.com/bazelbuild/apple_support/pull/552
# Remove this once the default has been flipped.
common --repo_env=APPLE_SUPPORT_RULES_BASED_TOOLCHAIN=1
common --repo_env=DO_NOT_TRACK=1

# rules_graalvm needs this for now for native_image:
# "Pass an executable or tools argument to ctx.actions.run or ctx.actions.run_shell instead of calling ctx.resolve_tools"
build --noincompatible_disallow_ctx_resolve_tools

# Strip symbols from Rust binaries (~21% smaller on macOS arm64: 455 KB -> 360 KB).
# Set here because rules_rust ignores Cargo [profile.release].
build --@rules_rust//:extra_rustc_flags=-Cstrip=symbols

build:quiet --ui_event_filters=-info,-stdout,-stderr
build:quiet --noshow_progress
build:quiet --noshow_loading_progress

# Keep --config=macos valid even when it doesn't need platform-specific flags.
build:macos --features=noop-this-is-because-we-have-no-config-flags-to-set-yet-on-macos

# Do Swift static linking on Linux
# Use the runner's Clang instead of installing an LLVM toolchain, whose download
# size and setup time would significantly increase CI duration.
common:linux --repo_env=CC=clang
build:linux --features=swift.static_stdlib

# CI-only settings. CI enables this config for every run (see
# .github/workflows/build-test.yml).
# CI starts with an empty disk cache, so skip writing every remote cache
# download to it as well.
build:ci --disk_cache=

# Remote cache
# CI enables this config when the BAZEL_REMOTE_BASIC_AUTH secret is available
# (see .github/workflows/build-test.yml), which also supplies the auth header.
# Keep builds working if the cache endpoint is unavailable.
build:remote_cache --remote_cache=grpcs://bazel-remote.sutton.computer
build:remote_cache --remote_local_fallback
build:remote_cache --incompatible_remote_local_fallback_for_remote_cache
build:remote_cache --remote_download_outputs=minimal
# bazel-remote stores blobs zstd-compressed, so it can serve them without recompressing.
build:remote_cache --remote_cache_compression
