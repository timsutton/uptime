build --compilation_mode=opt
build --java_runtime_version=remotejdk_21

# Use apple_support's new rules-based cc toolchain, which will eventually
# replace its legacy templated toolchain (off by default as of 2.7.0)
# https://github.com/bazelbuild/apple_support/pull/552
# Remove this once the default has been flipped.
common --repo_env=APPLE_SUPPORT_RULES_BASED_TOOLCHAIN=1

# rules_graalvm needs this for now for native_image:
# "Pass an executable or tools argument to ctx.actions.run or ctx.actions.run_shell instead of calling ctx.resolve_tools"
build --noincompatible_disallow_ctx_resolve_tools

build:quiet --ui_event_filters=-info,-stdout,-stderr
build:quiet --noshow_progress
build:quiet --noshow_loading_progress

# Keep --config=macos valid even when it doesn't need platform-specific flags.
build:macos --features=noop-this-is-because-we-have-no-config-flags-to-set-yet-on-macos

# Do Swift static linking on Linux
# - relies currently on a handcrafted patch from
#   https://github.com/bazelbuild/rules_swift/pull/706
build:linux --features=swift.static_stdlib

# Remote cache
# Use my Tailnet's remote cache on Linux, but keep builds working if the cache
# endpoint is unavailable.
build:linux --remote_cache=grpc://bazel-remote.tailff30e.ts.net:9092
build:linux --remote_local_fallback
build:linux --incompatible_remote_local_fallback_for_remote_cache
build:linux --remote_download_outputs=minimal
