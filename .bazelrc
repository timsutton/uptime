build --compilation_mode=opt
build --java_runtime_version=remotejdk_25

# rules_android builds its own Java tools, which need Java 17+ to compile and run.
build --tool_java_language_version=17
# JDK 24+ warns about protobuf's and Guava's sun.misc.Unsafe use, both when
# compiling them and when running rules_android's tools, so use JDK 21.
build --tool_java_runtime_version=remotejdk_21

# Reuse action outputs across clean builds and CI jobs.
build --disk_cache=~/.cache/bazel/disk

# Use apple_support's new rules-based cc toolchain, which will eventually
# replace its legacy templated toolchain (off by default as of 2.7.0)
# https://github.com/bazelbuild/apple_support/pull/552
# Remove this once the default has been flipped.
common --repo_env=APPLE_SUPPORT_RULES_BASED_TOOLCHAIN=1
common --repo_env=DO_NOT_TRACK=1

# rules_graalvm needs this for now for native_image:
# "Pass an executable or tools argument to ctx.actions.run or ctx.actions.run_shell instead of calling ctx.resolve_tools"
build --noincompatible_disallow_ctx_resolve_tools

# Require explicit Python package initializers in every module. rules_python's
# explicit_init_py module setting covers only the module that sets it, so
# dependencies such as rules_android would otherwise warn on every analysis.
# https://github.com/bazel-contrib/rules_python/issues/2945
common --@rules_python//python/config_settings:incompatible_default_to_explicit_init_py

# Strip symbols from Rust binaries (~21% smaller on macOS arm64: 455 KB -> 360 KB).
# Set here because rules_rust ignores Cargo [profile.release].
build --@rules_rust//:extra_rustc_flags=-Cstrip=symbols

build:quiet --ui_event_filters=-info,-stdout,-stderr
build:quiet --noshow_progress
build:quiet --noshow_loading_progress

# Keep --config=macos valid even when it doesn't need platform-specific flags.
build:macos --features=noop-this-is-because-we-have-no-config-flags-to-set-yet-on-macos

# Apply the *:linux and *:macos settings on those hosts without --config.
common --enable_platform_specific_config

# Do Swift static linking on Linux
# The cc toolchain on Linux comes from hermetic-llvm (see MODULE.bazel), so we
# no longer depend on the runner's Clang via CC=clang.
build:linux --features=swift.static_stdlib
# The platform applies to exec tools as well as targets: tests need an execution
# platform which satisfies the target platform's constraints.
build:linux --host_platform=//tools/platforms:linux_libstdcxx

# CI-only settings. CI enables this config for every run (see
# .github/workflows/build-test.yml).
# CI starts with an empty disk cache, so skip writing every remote cache
# download to it as well.
build:ci --disk_cache=

# Remote cache
# CI enables this config when the BAZEL_REMOTE_BASIC_AUTH secret is available
# (see .github/workflows/build-test.yml), which also supplies the auth header.
# Keep builds working if the cache endpoint is unavailable.
build:remote_cache --remote_cache=grpcs://bazel-remote.sutton.computer
build:remote_cache --remote_local_fallback
build:remote_cache --incompatible_remote_local_fallback_for_remote_cache
build:remote_cache --remote_download_outputs=minimal
# bazel-remote stores blobs zstd-compressed, so it can serve them without recompressing.
build:remote_cache --remote_cache_compression
# Fetch external dependencies through the remote cache's downloader, falling
# back to the original URLs if it is unavailable.
build:remote_cache --remote_downloader=grpcs://bazel-remote.sutton.computer
build:remote_cache --remote_downloader_local_fallback

# Remote execution on the homelab Buildbarn cluster, reachable from the LAN or
# Tailscale. The workers are Linux x86_64, so this builds Linux x86_64 binaries
# from any client: bazel build --config=remote //src/...
# Don't combine it with --config=linux, --config=macos or --config=remote_cache.
build:remote --remote_executor=grpcs://buildbarn.k8s.sutton.computer
build:remote --remote_cache=grpcs://buildbarn.k8s.sutton.computer
build:remote --remote_instance_name=homelab
build:remote --platforms=//tools/platforms:linux_x86_64_remote
build:remote --extra_execution_platforms=//tools/platforms:linux_x86_64_remote
build:remote --features=swift.static_stdlib
build:remote --spawn_strategy=remote
build:remote --noremote_local_fallback
# One worker with 20 execution slots.
build:remote --jobs=20
# Uploading language SDKs over a slow link can take longer than the default 60s.
build:remote --remote_timeout=10m
build:remote --remote_download_outputs=toplevel
# The cluster is the cache, so don't keep a second copy of everything locally.
build:remote --disk_cache=
# Upload and download only the changed chunks of large blobs.
build:remote --experimental_remote_cache_chunking
# Publish build events to Buildbarn Portal.
build:remote --bes_backend=grpcs://buildbarn-portal.k8s.sutton.computer
build:remote --bes_results_url=https://buildbarn-portal.k8s.sutton.computer/bazel-invocations/
build:remote --bes_upload_mode=fully_async

# Load optional per-user overrides after the shared repository settings.
try-import %workspace%/user.bazelrc
